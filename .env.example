PORT=7000
# Dossier/fichier SQLite (monté en volume dans Docker)
DB_PATH=./data/netflix.db
# Clé TMDB (v3 api_key ou token v4 "eyJ...") : https://www.themoviedb.org/settings/api
# Fortement recommandé : catalogue auto, épisodes/images de secours
TMDB_API_KEY=
# Mot de passe du dashboard /admin et des routes /admin/* (mets une longue valeur aléatoire)
# Peut ensuite être changé depuis l'onglet Paramètres du dashboard (priorité : dashboard > .env)
ADMIN_TOKEN=
REGION=FR
TMDB_LANG=fr-FR
NETFLIX_COUNTRY=fr
SYNC_PAGES=5
SYNC_EVERY_HOURS=24
# Catalogues « Dernières sorties » : nombre de jours remontés et pages TMDB par type (20 titres/page)
RECENT_DAYS=90
RECENT_PAGES=3
# URL publique de l'addon (sert aux bandes-annonces Netflix). En local : http://localhost:7000 ; sur le VPS : https://ton-domaine
PUBLIC_URL=http://localhost:7000
# Durée (secondes) pendant laquelle Stremio garde les fiches/catalogues en cache. Mets 0-60 pendant tes tests.
META_CACHE_SECONDS=300
# --- API de fédération ---
# Clé que les autres instances doivent fournir (en-tête x-api-key ou ?key=) pour appeler /api/trailers.
API_KEY=
# Pour récupérer les bandes-annonces d'une autre instance : URL de base + sa clé API.
UPSTREAM_URL=
UPSTREAM_API_KEY=
