PORT=7000
# Dossier/fichier SQLite (monté en volume dans Docker)
DB_PATH=./data/netflix.db
# Clé TMDB (v3 api_key ou token v4 "eyJ...") : https://www.themoviedb.org/settings/api
# Fortement recommandé : catalogue auto, épisodes/images de secours, bandes-annonces YouTube
TMDB_API_KEY=
# Protège /admin (ajout de titres Netflix). Mets une longue valeur aléatoire.
ADMIN_TOKEN=
REGION=FR
TMDB_LANG=fr-FR
NETFLIX_COUNTRY=fr
SYNC_PAGES=5
SYNC_EVERY_HOURS=24
