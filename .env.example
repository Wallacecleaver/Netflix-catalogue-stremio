PORT=7000
# Dossier/fichier SQLite (monté en volume dans Docker)
DB_PATH=./data/netflix.db
# Clé TMDB (v3 api_key ou token v4 "eyJ...") : https://www.themoviedb.org/settings/api
# Fortement recommandé : catalogue auto, épisodes/images de secours
TMDB_API_KEY=
# Mot de passe du dashboard /admin et des routes /admin/* (mets une longue valeur aléatoire)
# Peut ensuite être changé depuis l'onglet Paramètres du dashboard (priorité : dashboard > .env)
ADMIN_TOKEN=
REGION=FR
TMDB_LANG=fr-FR
NETFLIX_COUNTRY=fr
SYNC_PAGES=5
SYNC_EVERY_HOURS=24
# Plateformes dont la synchro TMDB liste le catalogue : 8 = Netflix, 337 = Apple TV+, 2 = Apple TV,
# 119 = Prime Video. Combinables : « 8,337 ». « all » = tout TMDB (des centaines de milliers de titres,
# à réserver à un usage ponctuel avec SYNC_PAGES élevé).
CATALOG_PROVIDERS=8,337
# Netflix ne sert ses bandes-annonces qu'en 768x432. Mets 1 pour proposer EN PLUS la vidéo YouTube
# de TMDB (1080p) sur les fiches qui ont déjà une bande-annonce Netflix/Apple.
YOUTUBE_AS_SOURCE=0
# Dernier recours : chercher la bande-annonce sur YouTube quand TMDB n'en fournit aucune.
# Matching strict (titre + « bande annonce », VF privilégiée) ; 0 pour désactiver.
YOUTUBE_SEARCH=1
# Catalogues « Dernières sorties » : nombre de jours remontés et pages TMDB par type (20 titres/page)
RECENT_DAYS=90
RECENT_PAGES=3
# URL publique de l'addon (sert aux bandes-annonces Netflix). En local : http://localhost:7000 ; sur le VPS : https://ton-domaine
PUBLIC_URL=http://localhost:7000
# Durée (secondes) pendant laquelle Stremio garde les fiches/catalogues en cache. Mets 0-60 pendant tes tests.
META_CACHE_SECONDS=300
# --- API de fédération ---
# Clé que les autres instances doivent fournir (en-tête x-api-key ou ?key=) pour appeler /api/trailers.
# Vide = API ouverte : les autres instances n'ont besoin que de l'URL (renseigne-la dans le dashboard VF).
API_KEY=
# Pour récupérer les bandes-annonces d'une autre instance : URL de base + sa clé API.
UPSTREAM_URL=
UPSTREAM_API_KEY=
# Bandes-annonces Apple TV (API web non documentée). APPLETV_ENABLED=0 pour désactiver.
APPLETV_ENABLED=1
APPLETV_STOREFRONT=143442
APPLETV_LOCALE=fr-FR
APPLETV_COUNTRY=fr
# Paramètres du client web tv.apple.com. Si la recherche renvoie une erreur 400, ouvre tv.apple.com, fais une recherche
# avec les outils réseau (F12) et recopie v / utscf / utsk de la requête /api/uts/v3/search.
APPLETV_API_VERSION=84
APPLETV_UTSCF=OjAAAAEAAAAAAAAAEAAAACMA
APPLETV_UTSK=6e3013c6d6fae3c2::::::235656c069bb0efb
# Nombre maximum de bandes-annonces Apple TV gardées par titre.
APPLETV_MAX_TRAILERS=2
# Conversion des flux HLS Apple TV en MP4 (cache disque) : hauteur max, poids max estimé, durée du cache.
HLS_CACHE_DIR=./data/hls
HLS_MAX_HEIGHT=720
HLS_MAX_MB=60
HLS_CACHE_DAYS=7
# Chemin de ffmpeg (facultatif si « ffmpeg » est déjà dans le PATH). Sans ffmpeg, pas de son dans les bandes-annonces Apple.
# Windows : winget install Gyan.FFmpeg    Debian/Ubuntu : apt install ffmpeg    macOS : brew install ffmpeg
FFMPEG_PATH=
# Recherche des IDs Netflix : JustWatch d'abord (gratuit, sans clé, déjà utilisé par le liage).
# La clé Brave Search n'est plus nécessaire ; elle ne sert que de secours si JustWatch tombe.
# DuckDuckGo n'est plus joignable de façon fiable (ECONNRESET) : ne pas compter dessus.
BRAVE_API_KEY=
BRAVE_COUNTRY=FR
BRAVE_LANG=fr
# Recherche automatique des bandes-annonces quand Stremio ouvre une fiche (nécessite TMDB_API_KEY). RESOLVE_ENABLED=0 pour désactiver.
RESOLVE_ENABLED=1
