{
  "name": "stockage-db",
  "version": "3.3.0",
  "description": "Stockage DB — serveur API REST universel, base multi-sources et relais MP4/HLS de bandes-annonces (Netflix, Apple TV+, liens directs)",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "add": "node scripts/add.js",
    "inspect": "node scripts/inspect.js",
    "inspect-appletv": "node scripts/inspect-appletv.js",
    "sync": "node scripts/sync.js",
    "netflix-ids": "node scripts/netflix-ids.js",
    "netflix-trailers": "node scripts/netflix-trailers.js",
    "api-check": "node scripts/api-check.js",
    "harvest": "node scripts/harvest-all.js",
    "harvest:recent": "node scripts/harvest-all.js --recent",
    "vf": "node scripts/vf-check.js",
    "test": "node scripts/smoke.js && node test/search-brave-itunes.test.js && node test/youtube.test.js && node test/audit-and-dashboard.test.js",
    "test:search": "node test/search-brave-itunes.test.js",
    "test:youtube": "node test/youtube.test.js",
    "seed": "node scripts/seed.js",
    "inspect-prime": "node scripts/inspect-prime.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  }
}
